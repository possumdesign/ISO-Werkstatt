<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ISO-Werkstatt – Builder" Width="1040" Height="820" MinWidth="920" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#F3F5F8" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#CFD7E2"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,8"/><Setter Property="Background" Value="#EDF1F6"/>
      <Setter Property="Foreground" Value="#19324B"/><Setter Property="BorderBrush" Value="#CFD7E2"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#243D53"/>
      <Setter Property="Margin" Value="0,12,0,6"/>
    </Style>
  </Window.Resources>
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,24">
      <StackPanel>
        <TextBlock Text="ISO-Werkstatt" FontSize="30" FontWeight="SemiBold" Foreground="#132F46"/>
        <TextBlock Text="Windows-Installationsmedien für Labor und PC" Foreground="#607184" Margin="0,5,0,0"/>
      </StackPanel>
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock Text="LOKALER BUILDER" FontSize="11" FontWeight="Bold" Foreground="#206552" HorizontalAlignment="Right" Margin="0,0,0,8"/>
