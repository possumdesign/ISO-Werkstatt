          </Button>
        </StackPanel>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
      <Border Background="White" CornerRadius="10" Padding="24" BorderBrush="#E0E6EC" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer x:Name="FormScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="Build vorbereiten" FontSize="20" FontWeight="SemiBold" Foreground="#132F46"/>
            <StackPanel x:Name="InputPanel">
              <TextBlock Text="Windows-ISO" Style="{StaticResource FieldLabel}"/>
              <DockPanel><Button x:Name="ReadEditions" Content="↻" DockPanel.Dock="Right" Width="36" Height="36" Padding="0" FontSize="22" Margin="6,0,0,0" ToolTip="Editionen neu einlesen"/><Button x:Name="BrowseWindows" Content="Auswählen" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="WindowsIso" ToolTip="Pfad zur Windows-Installations-ISO"/></DockPanel>
              <TextBlock x:Name="EditionHint" Text="Bitte zuerst eine Windows-ISO auswählen und erkennen lassen." TextWrapping="Wrap" Foreground="#607184" FontSize="12" Margin="0,6,0,0"/>
              <StackPanel x:Name="BuildOptions" IsEnabled="False">
              <TextBlock Text="Profil" Style="{StaticResource FieldLabel}"/>
              <DockPanel><Button x:Name="EditProfile" Content="Profil bearbeiten" DockPanel.Dock="Right" Margin="8,0,0,0"/><ComboBox x:Name="Profile" Padding="9,7" MinHeight="36"/></DockPanel>
              <TextBlock x:Name="ProfileSummary" Foreground="#607184" TextWrapping="Wrap" Margin="0,8,0,0"/>
              <CheckBox x:Name="CoreInstall" Content="Core – Headless" Visibility="Collapsed" Margin="0,12,0,0"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Edition" Style="{StaticResource FieldLabel}"/>
                  <DockPanel><ComboBox x:Name="Edition" IsEditable="False" IsTextSearchEnabled="False" Padding="9,7" MinHeight="36" ToolTip="Edition aus der erkannten ISO auswählen."/></DockPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Version" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="Version"/>
                </StackPanel>
              </Grid>

              <TextBlock Text="VirtIO-ISO" Style="{StaticResource FieldLabel}"/>
              <DockPanel><Button x:Name="BrowseVirtio" Content="Auswählen" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="VirtioIso" ToolTip="Pfad zur VirtIO-Treiber-ISO"/></DockPanel>
              <TextBlock x:Name="VirtioHint" TextWrapping="Wrap" Foreground="#607184" FontSize="12" Margin="0,6,0,0"/>
              <TextBlock Text="Windows-Produktschlüssel (optional)" Style="{StaticResource FieldLabel}"/>
              <PasswordBox x:Name="ProductKey" Padding="10,8" BorderBrush="#CFD7E2" BorderThickness="1" MaxLength="29"/>
              <TextBlock Text="Für Setup und Editionsauswahl; Aktivierung separat. Leer: Vorgabe der Antwortdatei, beim PC-Profil ohne festen Schlüssel." TextWrapping="Wrap" Foreground="#607184" FontSize="12" Margin="0,6,0,0"/>
              <Expander x:Name="OptionsMenu" Header="Zusätzliche Anpassungen" Margin="0,16,0,2">
                <StackPanel Margin="0,8,0,0">
                  <CheckBox x:Name="IncludeTools" Content="Tools-Ordner und Desktop-Verknüpfung" Margin="0,5"/>
                  <Button x:Name="OpenToolsFolder" Content="Tools-Ordner öffnen" HorizontalAlignment="Left" Margin="0,4,0,8" ToolTip="Eigene portable Programme oder ZIP-Dateien hier ablegen. Wird bei aktivierter Tools-Option in die ISO übernommen. Bitte die jeweiligen Lizenzbedingungen beachten."/>
                  <CheckBox x:Name="DisableWebSearch" Content="Bing / Websuche abschalten" Margin="0,5"/>
                  <CheckBox x:Name="IncludeUBlockLite" Content="uBlock Origin Lite installieren" Margin="0,5"/>
                  <CheckBox x:Name="IncludeQemu" Content="QEMU Guest Agent installieren" Margin="0,5"/>
                  <TextBlock Text="Gilt für diesen Build. Ein Profilwechsel setzt die Auswahl zurück." TextWrapping="Wrap" Foreground="#607184" FontSize="12" Margin="0,6,0,0"/>
                </StackPanel>
              </Expander>
              <TextBlock Text="Lokaler Kontoname" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="LocalUserName" ToolTip="1–20 Zeichen. Profilwechsel lädt den Standardnamen. Gilt auch für die automatische Anmeldung."/>
              <TextBlock Text="Kennwort für das lokale Konto" Style="{StaticResource FieldLabel}"/>
              <PasswordBox x:Name="Password" Padding="10,8" BorderBrush="#CFD7E2" BorderThickness="1"/>
              <TextBlock Text="Kennwort und optionaler Produktschlüssel werden in die Installations-ISO übernommen, nicht in Profil oder Build-Protokoll gespeichert." TextWrapping="Wrap" Foreground="#607184" FontSize="12" Margin="0,6,0,0"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
          <StackPanel Grid.Row="1">
            <TextBlock x:Name="Validation" Foreground="#AC3030" TextWrapping="Wrap" Margin="0,14,0,10"/>
            <Button x:Name="StartBuild" Content="ISO erstellen" Background="#126C60" Foreground="White" BorderBrush="#126C60" FontWeight="SemiBold" Padding="16,12"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="White" CornerRadius="10" Padding="22" BorderBrush="#E0E6EC" BorderThickness="1" Margin="0,0,0,18">
          <StackPanel>
            <TextBlock Text="Build-Status" FontSize="20" FontWeight="SemiBold" Foreground="#132F46"/>
            <TextBlock x:Name="Status" Text="Bereit für den ersten Build" FontSize="17" Foreground="#126C60" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,17,0,8"/>
            <ProgressBar x:Name="Progress" Height="7" Minimum="0" Maximum="100" Foreground="#126C60" Background="#E5ECEF" BorderThickness="0"/>
            <TextBlock x:Name="Duration" Text="Noch kein Lauf gestartet" Foreground="#607184" Margin="0,9,0,0"/>
            <TextBox x:Name="Result" Text="Nach dem Build findest du hier die fertige ISO und ihre Prüfsumme." IsReadOnly="True" TextWrapping="Wrap" Foreground="#445C71" Margin="0,16,0,0" BorderThickness="0" Padding="0" Background="Transparent" VerticalContentAlignment="Top" MaxHeight="150" VerticalScrollBarVisibility="Auto"/>
            <TextBox x:Name="Hash" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,10,0,0"/>
            <WrapPanel Margin="0,16,0,0">
              <Button x:Name="OpenOutput" Content="ISO anzeigen" IsEnabled="False" Margin="0,0,8,6"/>
              <Button x:Name="CopyHash" Content="SHA256 kopieren" IsEnabled="False" Margin="0,0,0,6"/>
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="#132B3D" CornerRadius="10" Padding="18">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Protokoll" Foreground="#E6EDF4" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBox x:Name="LogPreview" Grid.Row="1" Text="Der Build-Verlauf erscheint hier." IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Background="Transparent" Foreground="#BFD2DF" BorderThickness="0" Padding="0" FontFamily="Consolas" FontSize="11"/>
            <Button x:Name="OpenLog" Grid.Row="2" Content="Vollständiges Log öffnen" HorizontalAlignment="Left" IsEnabled="False" Margin="0,14,0,0"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <TextBlock Grid.Row="2" Text="Lokaler Builder für Windows 10/11 und Server 2022/2025. Neue Zielprofile zuerst testen." Foreground="#607184" FontSize="12" Margin="0,16,0,0" TextWrapping="Wrap"/>
  </Grid>
</Window>
