              <Polygon Points="3,9.57 3.129,9.912 3.495,9.929 3.209,10.158 3.306,10.511 3,10.31 2.694,10.511 2.791,10.158 2.505,9.929 2.871,9.912" Fill="White"/>
              <Polygon Points="5,9.57 5.129,9.912 5.495,9.929 5.209,10.158 5.306,10.511 5,10.31 4.694,10.511 4.791,10.158 4.505,9.929 4.871,9.912" Fill="White"/>
              <Polygon Points="7,9.57 7.129,9.912 7.495,9.929 7.209,10.158 7.306,10.511 7,10.31 6.694,10.511 6.791,10.158 6.505,9.929 6.871,9.912" Fill="White"/>
